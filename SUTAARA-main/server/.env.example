# Copy this file to .env and adjust as needed.

# Server
PORT=5000
NODE_ENV=development

# PostgreSQL — local example, or use a hosted instance (Neon/Supabase/RDS/Railway)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/sutaara
# Only relevant with a pooled connection (Neon pooler, PgBouncer): set this to
# the DIRECT (non-pooled) connection string. If you're not using a pooler,
# just copy the same value as DATABASE_URL.
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:5432/sutaara

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# CORS — comma-separated list of URLs your frontend runs on
CLIENT_URL=http://localhost:5173

# Default admin created by the seed script
ADMIN_NAME=Sutaara Admin
ADMIN_EMAIL=admin@sutaara.in
ADMIN_PASSWORD=admin123

# --- Optional: only needed once you're ready to go live with these ---

# GST rate as a decimal, e.g. 0.05 for 5%. Leave 0/unset pre-registration.
GST_RATE=0
STORE_GSTIN=
STORE_ADDRESS=Prayagraj, Uttar Pradesh, India
STORE_EMAIL=hello@sutaara.in

# Shipping/courier API — Shiprocket, Delhivery, Shadowfax, etc. Until these
# are set, orders get a mock AWB so the label/tracking flow still works in dev.
SHIPPING_PROVIDER=mock
SHIPPING_API_KEY=

# Payment gateway — Razorpay/Stripe. Not wired up yet (see README).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# SMS/Email OTP + transactional notifications — e.g. MSG91, Twilio, SendGrid, AWS SES.
SMS_API_KEY=
EMAIL_API_KEY=

# WhatsApp order notifications — WhatsApp Business Cloud API token.
WHATSAPP_API_TOKEN=

# Demo/test login — lets anyone sign in instantly with a generated fake email,
# no password or verification. Always on in development. In production it's
# OFF by default; set to "true" only if you want the button live for demos.
ALLOW_DEMO_LOGIN=false

# Google Sign-In — OAuth Client ID from Google Cloud Console (Credentials ->
# Create Credentials -> OAuth client ID -> Web application). Same value also
# goes in client/.env as VITE_GOOGLE_CLIENT_ID. See README for setup steps.
GOOGLE_CLIENT_ID=

# Email — required for sign-up verification codes.
# Without these, codes are logged to the server console instead of emailed
# (fine locally, refused in production so nobody registers into a locked
# account). Gmail needs an App Password, not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your_16_char_app_password
MAIL_FROM=Sutaara <no-reply@sutaara.in>