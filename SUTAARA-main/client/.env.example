# Optional. In development the Vite dev-server proxies "/api" to the
# Express server (see vite.config.js), so you usually don't need this.
# Set it only if you host the API on a different origin.
# VITE_API_URL=http://localhost:5000/api

# Google Sign-In — same OAuth Client ID as server/.env's GOOGLE_CLIENT_ID.
# Without this set, the "Continue with Google" button simply doesn't render
# and email/password auth keeps working as before.
VITE_GOOGLE_CLIENT_ID=
